#!/bin/bash
# Type I (x86_64) CUDA-free CPU route in one whole-node t1-single job: two
# independent builds, then reference agreement and 1/16/48-thread timing of the
# SHA-256-verified wheel of build-1. Every step keeps its own run directory.
# Submit: qsub -q t1-single -v JOB_ROOT=<root> type1.pbs
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -r n
set -Eeuo pipefail
umask 077
: "${JOB_ROOT:?}"
here=$JOB_ROOT/source/radia-optuna/tools/flow2
test "$(uname -m)" = x86_64
for run in build-1 build-2; do
  PROFILE=cpu RUN=$run bash "$here/build.pbs"
done
RUN=validate-1 BUILD=build-1 bash "$here/validate_cpu.sh"
