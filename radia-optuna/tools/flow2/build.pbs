#!/bin/bash
# Build a radia-optuna Linux Python wheel from the staged exact source.
# PROFILE=gpu (default): Type II (aarch64), nvcc 12.8 CUDA backend.
#   qsub -q t2-dev -l gpu=1 -v JOB_ROOT=<root>,RUN=<build-N> build.pbs
# PROFILE=cpu: Type I (x86_64), host C++ only, no CUDA; type1.pbs runs it as a step.
#PBS -l walltime=00:40:00
#PBS -j oe
#PBS -r n
set -Eeuo pipefail
umask 077
: "${JOB_ROOT:?}" "${RUN:?}"
profile=${PROFILE:-gpu}
case $profile in
  gpu) machine=aarch64 ;;
  cpu) machine=x86_64 ;;
  *) echo "PROFILE must be gpu or cpu" >&2; exit 2 ;;
esac
cuda=${CUDA_HOME_FLOW2:-/home/center/opt/aarch64/cores/cuda/12.8}
cxx=${CXX_FLOW2:-/usr/bin/g++}
arch=${CUDA_ARCH_FLOW2:-100}
threads=${OMP_THREADS_FLOW2:-8}
run=$JOB_ROOT/$RUN
mkdir "$run"
cd "$run"
exec >run.log 2>&1
phase=allocation
trap 'rc=$?; printf "phase=%s\nexit_code=%s\n" "$phase" "$rc" > terminal.txt' EXIT
test "$(uname -m)" = "$machine"
python3.12 -c 'import json,os,socket,sys; json.dump({"run":sys.argv[1],"pbs_jobid":os.environ["PBS_JOBID"],"node":socket.gethostname()},open("job.json","w"),indent=2)' "$RUN"
(cd "$JOB_ROOT" && sha256sum --quiet -c inputs.sha256)
sha=$(python3.12 -c 'import json,sys; print(json.load(open(sys.argv[1]))["source_sha"])' "$JOB_ROOT/owner.json")
python3.12 - "$JOB_ROOT/owner.json" <<'PY'
import datetime, json, sys
deadline = datetime.datetime.fromisoformat(json.load(open(sys.argv[1]))["deadline_utc"])
assert datetime.datetime.now(datetime.timezone.utc) < deadline, "past the owner.json deadline"
PY
cores=$(python3.12 -c 'import os,sys; a=sorted(os.sched_getaffinity(0)); n=int(sys.argv[1]); assert len(a)>=n; print(",".join(map(str,a[:n])))' "$threads")
taskset -pc "$cores" $$ > affinity.txt
echo "$cores" > cpus.txt
export OMP_NUM_THREADS=$threads PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
unset PYTHONPATH
phase=environment
python3.12 -m venv venv
if [ "$profile" = gpu ]; then
  export PATH="$run/venv/bin:$cuda/bin:$PATH"
  "$cuda/bin/nvcc" --version > nvcc.txt
  toolchain=(--nvcc "$cuda/bin/nvcc" --cuda-architectures "$arch")
else
  export PATH="$run/venv/bin:$PATH"
  toolchain=()   # CUDA-free: no CUDA tool on PATH or in the build
fi
python -m pip install -q --no-index --require-hashes --find-links "$JOB_ROOT/wheelhouse-build" \
  -r "$JOB_ROOT/source/radia-optuna/tools/flow2/requirements-build.txt"
python -m pip freeze > freeze.txt
"$cxx" -dumpfullversion > cxx.txt
phase=checkout
git clone -q --no-hardlinks "$JOB_ROOT/source" src   # independent tree per build
git -C src checkout -q --detach "$sha"
test "$(git -C src rev-parse HEAD)" = "$sha"
SOURCE_DATE_EPOCH=$(git -C src log -1 --format=%ct)
export SOURCE_DATE_EPOCH
phase=native-build
python src/radia-optuna/tools/build_linux_python.py --profile "$profile" \
  --build-dir "$run/build" --cxx "$cxx" "${toolchain[@]}"
phase=wheel
python -m pip wheel -q --no-index --no-build-isolation --no-deps -w dist src/radia-optuna
wheels=(dist/*.whl)
test ${#wheels[@]} -eq 1
(cd dist && sha256sum ./*.whl) > wheel.sha256
cp src/radia-optuna/src/radia_optuna/native_build.json public-receipt.json
cp build/python-build.json private-receipt.json
phase=complete
